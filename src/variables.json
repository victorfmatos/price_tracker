{
  "amazon": {
    "domains": ["amazon.com.br", "amazon.com"],
    "selectors": {
      "title": ["#productTitle", "#title span"],
      "promotion_price": [
        "#corePriceDisplay_desktop_feature_div .priceToPay .a-offscreen",
        "#corePrice_feature_div .a-price .a-offscreen"
      ],
      "real_price": [
        "#corePriceDisplay_desktop_feature_div .basisPrice .a-offscreen",
        "#corePrice_feature_div span[data-a-strike='true'] .a-offscreen"
      ],
      "average_rating": [
        "#acrPopover .a-size-base.a-color-base",
        "#acrPopover .a-icon-alt"
      ],
      "ratings_quantity": ["#acrCustomerReviewText"],
      "description": [
        "#feature-bullets ul li span.a-list-item",
        "#productDescription p"
      ],
      "specifications": [
        "#productDetails_techSpec_section_1 th, #productDetails_techSpec_section_2 th",
        "#productDetails_techSpec_section_1 td, #productDetails_techSpec_section_2 td"
      ]
    }
  },
  "mercado_livre": {
    "domains": ["mercadolivre.com.br", "mercadolibre.com"],
    "selectors": {
      "title": ["h1.ui-pdp-title", "h1"],
      "promotion_price": [
        "#price .ui-pdp-price__second-line .andes-money-amount",
        "#price .ui-pdp-price__second-line .ui-pdp-price__part"
      ],
      "real_price": [
        "#price s.andes-money-amount",
        "#price s.ui-pdp-price__part"
      ],
      "average_rating": [
        ".ui-pdp-review__rating",
        "p.ui-review-capability__rating__average"
      ],
      "ratings_quantity": [
        ".ui-pdp-review__amount",
        "p.ui-review-capability__rating__label"
      ],
      "description": [".ui-pdp-description__content", ".ui-pdp-description p"],
      "specifications": [".andes-table tr th", ".andes-table tr td"]
    }
  }
}
